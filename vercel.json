{
  "version": 2,
  "builds": [
    {
      "src": "src/main.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "**/.venv/**, **/.env, **/uv.lock, **/__pycache__/**, **/pyproject.toml"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.py"
    }
  ]
}